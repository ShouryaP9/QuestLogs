# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard -> Project Settings -> API).
# The anon key is safe to expose to the browser; row-level security policies
# in supabase/schema.sql are what actually protect each user's data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
